{
  "expo": {
    "name": "HeatGuard",
    "slug": "heatguard",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "heatguard",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "org.heatguard.app",
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": ["processing"],
        "BGTaskSchedulerPermittedIdentifiers": ["com.expo.modules.backgroundtask.processing"]
      }
    },
    "android": {
      "package": "org.heatguard.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#58CC02"
      }
    },
    "web": { "bundler": "metro", "name": "HeatGuard", "favicon": "./assets/favicon.png" },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "HeatGuard uses your location to find local heat conditions and nearby cooling places."
        }
      ],
      "expo-secure-store",
      "expo-notifications",
      "expo-background-task"
    ]
  }
}
