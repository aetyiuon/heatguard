NWS_USER_AGENT=HeatGuard/0.1 (replace-with-your-real-support-email)
# Optional. Register with AirNow. Never use EXPO_PUBLIC_ for this key.
AIRNOW_API_KEY=
# Comma-separated web origins. Native apps do not require browser CORS.
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:8082
# Optional authoritative municipal GeoJSON feed; normalize properties as documented.
MUNICIPAL_GEOJSON_URL=
